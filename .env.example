# ==============================================================================
# Environment Configuration
# ==============================================================================

# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-random-secure-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Set USE_POSTGRES=True to connect to PostgreSQL.
# In development, if USE_POSTGRES=False or unset, safe fallback to SQLite is used.
USE_POSTGRES=False
DB_NAME=videocalculator_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Static and Media Settings (optional overrides)
# STATIC_URL=/static/
# MEDIA_URL=/media/

